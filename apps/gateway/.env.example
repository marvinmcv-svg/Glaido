# Copy to .env.local (git-ignored). Never commit real values.
PORT=8787
# Supabase project URL (`supabase status` → API_URL locally). Enables JWKS token verification.
SUPABASE_URL=http://127.0.0.1:54321
# Optional legacy HS256 secret, only for projects still on symmetric JWTs.
SUPABASE_JWT_SECRET=
MIN_CLIENT_VERSION=0.1.0
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
RUST_LOG=info
