# Copy to .env.local (git-ignored). Never commit real values.
PORT=8787
# Supabase project URL (`supabase status` → API_URL locally). Enables JWKS token verification.
SUPABASE_URL=http://127.0.0.1:54321
# Optional legacy HS256 secret, only for projects still on symmetric JWTs.
SUPABASE_JWT_SECRET=
MIN_CLIENT_VERSION=0.1.0
# Speech-to-text, tried in this order (providers without a key are skipped).
STT_PROVIDERS=groq,deepgram
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Dictation cleanup. Without a key, dictation still works with deterministic formatting.
ANTHROPIC_API_KEY=
ANTHROPIC_CLEANUP_MODEL=claude-haiku-5-5
# Optional overrides (models, base URLs for proxies or tests):
# GROQ_STT_MODEL=whisper-large-v3-turbo
# DEEPGRAM_STT_MODEL=nova-3
# GROQ_BASE_URL= DEEPGRAM_BASE_URL= ANTHROPIC_BASE_URL=
RUST_LOG=info
